# ===========================================
# Digital Marketing Partner Portal — Environment Configuration
# Copy this file to server/.env and fill in real values.
# ===========================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173

# --- MySQL Database (XAMPP default values shown) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=partner_portal
DB_CONNECTION_LIMIT=10

# --- JWT Authentication ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Password Hashing ---
BCRYPT_SALT_ROUNDS=10

# --- File Uploads ---
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# --- Email (nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Digital Marketing Partner Portal
SMTP_FROM_EMAIL=no-reply@example.com

# --- Rate Limiting ---
# Per-IP ceiling per window across the whole API. An authenticated dashboard
# load costs ~15 requests, so keep this in the thousands for real usage.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1500

# --- Bootstrap Admin Seed (server/database/seed.js) ---
SEED_ADMIN_EMAIL=admin@partnerportal.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=your_oauth_web_client_id.apps.googleusercontent.com
